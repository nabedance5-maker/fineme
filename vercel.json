{
  "framework": "nextjs",
  "buildCommand": "node scripts/copy-static.js && next build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/expire-counters",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/line-reminder",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/weekly-nudge",
      "schedule": "0 0 * * 1"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "finemenextjs.vercel.app" }],
      "destination": "https://fineme.me/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization,x-internal-key" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/components/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
