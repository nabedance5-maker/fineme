{
  "framework": "nextjs",
  "buildCommand": "node scripts/copy-static.js && next build",
  "outputDirectory": ".next",
  "crons": [
    { "path": "/api/cron/x-post", "schedule": "0 0 * * *" },
    { "path": "/api/cron/x-engage", "schedule": "0 0 * * *" },
    { "path": "/api/cron/cleanup-mirror-sessions", "schedule": "0 2 * * *" },
    { "path": "/api/cron/cleanup-unpaid-mirror-photos", "schedule": "0 3 * * *" },
    { "path": "/api/cron/mirror-report", "schedule": "0 0 * * 1" },
    { "path": "/api/cron/sns-trend-draft", "schedule": "0 0 * * 0" },
    { "path": "/api/cron/note-draft", "schedule": "0 0 * * 3" },
    { "path": "/api/cron/auto-visited", "schedule": "0 */2 * * *" },
    { "path": "/api/cron/index-submit", "schedule": "0 2 * * *" },
    { "path": "/api/cron/seo-bulk-submit", "schedule": "0 1 * * 0" },
    { "path": "/api/cron/expire-counters", "schedule": "0 * * * *" },
    { "path": "/api/cron/seo-report", "schedule": "0 0 * * 1" },
    { "path": "/api/cron/seo-improve", "schedule": "30 0 * * *" },
    { "path": "/api/cron/pdca-critic", "schedule": "0 21 * * *" },
    { "path": "/api/cron/pdca-daily", "schedule": "0 22 * * *" },
    { "path": "/api/cron/line-reminder", "schedule": "0 15 * * *" },
    { "path": "/api/cron/reservation-alert", "schedule": "0 15 * * *" },
    { "path": "/api/cron/story-reminder", "schedule": "0 12 * * *" },
    { "path": "/api/cron/review-request", "schedule": "0 8 * * *" },
    { "path": "/api/cron/weekly-nudge", "schedule": "0 0 * * 1" },
    { "path": "/api/cron/monthly-report", "schedule": "0 0 1 * *" },
    { "path": "/api/cron/mirror-voice-request", "schedule": "0 * * * *" },
    { "path": "/api/cron/belle-article", "schedule": "0 4 * * *" },
    { "path": "/api/cron/mirror-reshoot-nudge", "schedule": "30 4 * * *" },
    { "path": "/api/cron/log-reminder", "schedule": "0 0 * * *" },
    { "path": "/api/cron/birthday-nudge", "schedule": "0 1 * * *" },
    { "path": "/api/cron/pinterest-draft", "schedule": "0 1 * * 4" },
    { "path": "/api/cron/provider-log-toolkit-announce", "schedule": "0 1 * * *" },
    { "path": "/api/cron/qanda-scout", "schedule": "0 1 * * 1" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "finemenextjs.vercel.app" }],
      "destination": "https://fineme.me/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization,x-internal-key" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/components/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
